# 本地监听
M10_FACE_HOST=0.0.0.0
M10_FACE_PORT=8765
M10_FACE_VIDEO_DIR=/opt/m10-face-ui/video
M10_FACE_DEFAULT_STATE=1

# 可选：保护写接口；不设置时适合可信内网
M10_FACE_API_TOKEN=

# 可选：本机主动轮询服务器。不设置时只接收 HTTP/WebSocket 推送。
M10_FACE_SERVER_URL=
M10_FACE_SERVER_TOKEN=
M10_FACE_POLL_INTERVAL=1.0
M10_FACE_SERVER_TIMEOUT=15.0
